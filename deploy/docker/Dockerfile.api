# Bayesian Credit — API + Temporal job worker image (entrypoint modes: serve, worker, …)
# Build from the repository root:  docker build -f deploy/docker/Dockerfile.api -t bayesian-credit-api .
# Dependencies come from poetry.lock (main group only), installed into /opt/venv.

# ---------------------------------------------------------------- dependencies (Poetry)
FROM python:3.14-slim AS deps

ENV PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=2.4.1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN python -m venv /opt/poetry && /opt/poetry/bin/pip install "poetry==${POETRY_VERSION}" \
    && python -m venv /opt/venv
WORKDIR /app

# 1. third-party packages (cached unless the lock or the manifests change)
COPY pyproject.toml poetry.lock poetry.toml ./
COPY core/pyproject.toml core/
RUN /opt/poetry/bin/poetry install --only main --no-root --no-directory

# 2. the modelling library (editable path dependency → /app/core)
COPY core/ core/
RUN /opt/poetry/bin/poetry install --only main --no-root

# ---------------------------------------------------------------- runtime
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    DJANGO_SETTINGS_MODULE=config.settings \
    DATA_ROOT=/app/data \
    ARTIFACT_ROOT=/app/data/artifacts \
    LENDING_CLUB_PATH=/app/data/raw/accepted_2007_to_2018Q4.csv.gz

RUN useradd --create-home --uid 10001 app
WORKDIR /app

COPY --from=deps /opt/venv /opt/venv
COPY core/ /app/core/
COPY api/ /app/api/
COPY scripts/ /app/scripts/
COPY deploy/docker/entrypoint.sh /app/entrypoint.sh
# static files are collected at build time, so the container may run as any uid (compose: the host user)
RUN chmod +x /app/entrypoint.sh && mkdir -p /app/data/artifacts /app/data/raw /app/data/processed \
    && cd /app/api && python manage.py collectstatic --noinput >/dev/null \
    && chown -R app:app /app

USER app
WORKDIR /app/api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/').status==200 else 1)"
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["serve"]
