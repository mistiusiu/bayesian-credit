# Bayesian Credit — research console (static build served by nginx, /api proxied to the API service)
# Build from the repository root:  docker build -f deploy/docker/Dockerfile.frontend -t bayesian-credit-web .
FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ENV VITE_API_MOCK=0 VITE_API_BASE=/api/v1
RUN pnpm build

FROM nginx:1.27-alpine
COPY deploy/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
ENV API_UPSTREAM=http://api:8000
EXPOSE 80
